      {
        "name": "remove_from_wishlist",
        "title": "Remove from wishlist",
        "description": "Remove a product (by slug) from the signed-in user's wishlist.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Product slug to remove."
